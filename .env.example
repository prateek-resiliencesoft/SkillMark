# ==========================================
# Resiliencesoft Interview AI Environment Configuration Example
# ==========================================

# Database Configuration (Postgres 16)
POSTGRES_USER=skillmark
POSTGRES_PASSWORD=generate_a_secure_random_password_here
POSTGRES_DB=skillmark
POSTGRES_PORT=5433

# PostgREST Configuration
POSTGREST_PORT=3001
POSTGREST_URL=http://127.0.0.1:3001

# Auth Secret (Minimum 32 characters, used for signing session JWTs)
# Generate with: openssl rand -hex 32
AUTH_SECRET=generate_a_secure_32_character_random_hex_secret_here

# Application Public URL (e.g. https://yourdomain.com or http://YOUR_SERVER_IP:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File storage: recordings, images and CVs are saved on this server's disk.
STORAGE_DIR=./storage

# Cron auth for POST/GET /api/cron/purge-media (set-aside media after 15 days)
CRON_SECRET=

# Grafana Cloud (service account) — super-admin /admin/server-logs
GRAFANA_URL=https://YOURSTACK.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_LOKI_DATASOURCE_UID=grafanacloud-logs
GRAFANA_LOG_INSTANCE=skillmark
# Prometheus datasource for /admin/server-activity graphs (node_exporter metrics)
GRAFANA_PROM_DATASOURCE_UID=grafanacloud-prom

# UptimeRobot — public /api/public/status + super-admin /admin/status
UPTIMEROBOT_API_KEY=


# AI Provider API Keys (Optional fallbacks for organization defaults)
GEMINI_API_KEY=
# Current Flash id (2.0 / 2.5 flash 404 for new keys; 3.5 routes to 3.6)
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
# Optional override (default openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Stripe billing (optional — leave blank for self-hosted / no card checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Code execution (OnlineCompiler.io REST API key, server-side only)
CODE_RUNNER_API_KEY=

# Landing Page Controls (/admin/landing)
# Public marketing site origin (iframe preview + bundled media thumbs)
NEXT_PUBLIC_LANDING_URL=https://resiliencesoftinterview.com
# Optional: trigger GitHub Actions rebuild after Publish (runtime API still works without these)
LANDING_DEPLOY_GITHUB_TOKEN=
LANDING_DEPLOY_REPO=prateek-resiliencesoft/SkillMark-LandingPage
LANDING_DEPLOY_WORKFLOW=deploy-landing.yml
LANDING_DEPLOY_REF=main

# AI Bug Triage → GitHub Issues (/admin/ai + /api/cron/bug-triage)
# Prefer GitHub App; PAT is fallback when App fails or is unset.
GITHUB_REPO=prateek-resiliencesoft/SkillMark
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PKCS8 PEM; use \n for newlines in a single-line env value
GITHUB_APP_PRIVATE_KEY=
GITHUB_TOKEN=


# Optional fallback for the storage cap. The preferred way is the super-admin UI (Stored Files > Set storage cap).
# On server-disk storage the cap is enforced: warnings at 80% / 95%, new uploads refused at 100%.
# Used only when nothing is saved there.
# STORAGE_QUOTA_GB=10

# Round 2 live interviews (LiveKit video + AI copilot)
# Browser-facing signaling URL (prod: wss://<your-domain>, Caddy proxies /rtc → livekit:7880;
# staging: wss://dev.resiliencesoftinterview.com — set in /opt/skillmark-dev/.env.dev, not GitHub secrets;
# local: ws://localhost:7880 with `docker compose --profile video up -d livekit`, keys devkey/secret)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: server-to-server LiveKit API URL when different from LIVEKIT_URL (prod compose sets http://livekit:7880)
# LIVEKIT_API_URL=
# Shared secret between the app and the round2-agent transcription service
ROUND2_AGENT_SECRET=
# Speech-to-text for the agent: any OpenAI-compatible /audio/transcriptions endpoint.
# Defaults to OPENAI_API_KEY + https://api.openai.com/v1 + gpt-4o-mini-transcribe (Groq: whisper-large-v3-turbo)
ROUND2_STT_API_KEY=
ROUND2_STT_BASE_URL=
ROUND2_STT_MODEL=
# Max LLM tokens the live copilot may spend per round 2 interview (default 250000)
# ROUND2_AI_TOKEN_BUDGET=
# Live AI score suggestions during round 2 (on by default; "off" disables). Min gap between auto runs (ms).
# ROUND2_LIVE_SCORING=on
# ROUND2_LIVE_SCORING_GAP_MS=60000
# Per-task AI: orgs pick provider order in Settings → AI (Round 2 · live copilot / live scoring /
# final report / transcript). Platform default order when an org hasn't chosen (comma list of
# openai,gemini,anthropic,groq,nvidia,custom; transcript: groq,openai,custom):
# AI_ROUTING_ROUND2_LIVE=groq,gemini,openai
# AI_ROUTING_ROUND2_SCORING=gemini,openai
# AI_ROUTING_ROUND2_REPORT=openai,gemini
# AI_ROUTING_ROUND2_TRANSCRIPT=groq,openai
# Per-task model for one provider: AI_MODEL_<TASK>_<PROVIDER> (any task, e.g. REPORT, ROUND2_LIVE)
# AI_MODEL_ROUND2_LIVE_GROQ=llama-3.3-70b-versatile
# AI_MODEL_ROUND2_SCORING_GEMINI=gemini-3.6-flash
# AI_MODEL_ROUND2_REPORT_OPENAI=gpt-4o
# AI_MODEL_ROUND2_TRANSCRIPT_GROQ=whisper-large-v3-turbo
# AI_MODEL_ROUND2_TRANSCRIPT_OPENAI=gpt-4o-mini-transcribe

# Google sign-in (external panel interviewers + optional for everyone)
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI tracing (Langfuse). Every LangGraph flow (question generation/refine, round 1 summary,
# round 2 plan/copilot/report) is traced when both keys are set; otherwise tracing is a no-op.
# Recruiters always see the step timeline in-app (ai_runs table); admins also get a Langfuse link.
# Dev: docker compose -f docker-compose.langfuse.yml --profile langfuse up -d  (UI http://localhost:3030)
#      keys must look like pk-lf-… / sk-lf-…; first boot creates them plus the admin user below.
# Prod: set the LANGFUSE_SERVER_SECRET deploy secret (+ LANGFUSE_DOMAIN) to run the bundled stack;
#      deploy derives the DB/ClickHouse/MinIO/Redis/NextAuth secrets from it. Or point at Langfuse Cloud.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Where the app sends traces (prod self-host: http://langfuse-web:3000; dev default http://localhost:3030)
# LANGFUSE_BASE_URL=
# Browser URL used for the admin "open in Langfuse" link + the project id (self-host default: skillmark)
# LANGFUSE_PUBLIC_URL=http://localhost:3030
# LANGFUSE_PROJECT_ID=skillmark
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_PASSWORD=
# Set false to send only metadata/tokens (no prompts or completions) to Langfuse
# LANGFUSE_CAPTURE_CONTENT=true
# LANGFUSE_TRACING_ENVIRONMENT=production
# Round 1 summaries: grounded evidence extraction step before scoring (default on)
# ROUND1_EVIDENCE_EXTRACTION=true
