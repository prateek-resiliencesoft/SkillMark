# ==========================================
# Resiliencesoft Interview AI Environment Configuration Example
# ==========================================

# Database Configuration (Postgres 16)
POSTGRES_USER=skillmark
POSTGRES_PASSWORD=generate_a_secure_random_password_here
POSTGRES_DB=skillmark
POSTGRES_PORT=5433

# PostgREST Configuration
POSTGREST_PORT=3001
POSTGREST_URL=http://127.0.0.1:3001

# Auth Secret (Minimum 32 characters, used for signing session JWTs)
# Generate with: openssl rand -hex 32
AUTH_SECRET=generate_a_secure_32_character_random_hex_secret_here

# Application Public URL (e.g. https://yourdomain.com or http://YOUR_SERVER_IP:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Storage — local fallback when S3 unset
STORAGE_DIR=./storage

# Backblaze B2 (S3-compatible) — preferred; free tier, no credit card.
# B2 → Buckets → Create → App Keys → generate key with access to this bucket.
# Endpoint/region shown on bucket page (EU Central = eu-central-003).
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_REGION=eu-central-003
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=skillmark

# Cron auth for POST/GET /api/cron/purge-media (set-aside media after 15 days)
CRON_SECRET=

# Grafana Cloud (service account) — super-admin /admin/server-logs
GRAFANA_URL=https://YOURSTACK.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_LOKI_DATASOURCE_UID=grafanacloud-logs
GRAFANA_LOG_INSTANCE=skillmark
# Prometheus datasource for /admin/server-activity graphs (node_exporter metrics)
GRAFANA_PROM_DATASOURCE_UID=grafanacloud-prom

# UptimeRobot — public /api/public/status + super-admin /admin/status
UPTIMEROBOT_API_KEY=


# AI Provider API Keys (Optional fallbacks for organization defaults)
GEMINI_API_KEY=
# Current Flash id (2.0 / 2.5 flash 404 for new keys; 3.5 routes to 3.6)
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Stripe billing (optional — leave blank for self-hosted / no card checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Code execution (OnlineCompiler.io REST API key, server-side only)
CODE_RUNNER_API_KEY=
