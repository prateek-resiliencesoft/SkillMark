# App SaaS
{$SITE_ADDRESS::80} {
	encode gzip

	@voice path /ws/voice* /ws/openai-voice*
	reverse_proxy @voice voice:8082

	reverse_proxy app:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# Landing www → apex
www.resiliencesoftinterview.com {
	redir https://resiliencesoftinterview.com{uri} permanent
}

# Landing static (Vite SPA)
resiliencesoftinterview.com {
	encode gzip
	root * /srv/landing
	try_files {path} /index.html
	file_server
}
