# App SaaS
{$SITE_ADDRESS::80} {
	encode gzip

	# Whole-recording uploads go up to 100MB; everything else (CVs, forms,
	# recording parts, MCP files) stays under 25MB.
	@largeUpload path /api/session/upload
	request_body @largeUpload {
		max_size 110MB
	}
	@regularBody not path /api/session/upload
	request_body @regularBody {
		max_size 32MB
	}

	# The relay checks Origin and the session cookie; it trusts X-Real-IP from here only.
	@voice path /ws/voice* /ws/openai-voice*
	reverse_proxy @voice voice:8082 {
		header_up -CF-Connecting-IP
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
	}

	reverse_proxy app:3000 {
		header_up Host {host}
		header_up -CF-Connecting-IP
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}

# Landing www → apex
www.resiliencesoftinterview.com {
	redir https://resiliencesoftinterview.com{uri} permanent
}

# Landing static (Vite SPA)
resiliencesoftinterview.com {
	encode gzip
	root * /srv/landing
	try_files {path} /index.html
	file_server
}

# Dev app. The waker on the docker bridge starts the dev stack, then proxies.
# Dev containers are stopped when idle so they do not use production RAM.
dev.resiliencesoftinterview.com {
	encode gzip

	@largeUpload path /api/session/upload
	request_body @largeUpload {
		max_size 110MB
	}
	@regularBody not path /api/session/upload
	request_body @regularBody {
		max_size 32MB
	}

	reverse_proxy 172.18.0.1:3199 {
		header_up Host {host}
		header_up -CF-Connecting-IP
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Host {host}
		transport http {
			response_header_timeout 90s
			dial_timeout 10s
		}
	}
}
