# Skillmark voice WebSocket relay (Doubao / Azure OpenAI / Gemini)
FROM node:20-bookworm-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY server ./server
COPY src ./src
COPY scripts/voice-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV NODE_ENV=production
ENV VOICE_RELAY_HOST=0.0.0.0
ENV VOICE_RELAY_PORT=8082
ENV OPENAI_VOICE_RELAY_PORT=8082
ENV GEMINI_VOICE_RELAY_PORT=8082

EXPOSE 8082
CMD ["/entrypoint.sh"]
