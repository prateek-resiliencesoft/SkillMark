# Resiliencesoft Interview AI voice WebSocket relay (Doubao / Azure OpenAI / Gemini)

# Dependency manifest without "scripts": editing npm scripts (e.g. test:web)
# must not invalidate the ~700MB npm ci layer, which every deploy host then
# has to download and extract again.
FROM node:22-bookworm-slim AS manifest
WORKDIR /app
COPY package.json package-lock.json ./
RUN node -e "const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));delete p.scripts;fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\n')"

FROM node:22-bookworm-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=manifest /app/package.json /app/package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY server ./server
COPY src ./src
COPY scripts/voice-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV NODE_ENV=production
ENV VOICE_RELAY_HOST=0.0.0.0
ENV VOICE_RELAY_PORT=8082
ENV OPENAI_VOICE_RELAY_PORT=8082
ENV GEMINI_VOICE_RELAY_PORT=8082

EXPOSE 8082
CMD ["/entrypoint.sh"]
