{
  "name": "skillmark",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI interview platform for voice, chat, and video",
  "repository": {
    "type": "git",
    "url": "https://github.com/1146345502/aural-oss.git"
  },
  "homepage": "https://github.com/1146345502/aural-oss#readme",
  "bugs": {
    "url": "https://github.com/1146345502/aural-oss/issues"
  },
  "license": "MIT",
  "author": "Skillmark",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:web": "node --import tsx --test tests/session-score.test.ts tests/relay-routing.test.ts tests/voice-save-route.test.ts tests/playback-jitter-buffer.test.ts tests/openai-voice-relay-helpers.test.ts tests/voice-relay-helpers.test.ts tests/api-rate-limit.test.ts tests/interview-templates.test.ts tests/api-key-auth.test.ts tests/session-lifecycle.test.ts tests/voice-relay-reconnect.test.ts tests/theme-tokens.test.ts tests/tailwind-palette.test.ts tests/theme-provider.test.ts tests/question-bank-router.test.ts tests/generator-prompt.test.ts tests/theme-transition.test.ts tests/bklit-dashboard-components.test.ts tests/flipping-word-swap.test.ts tests/head-movement.test.ts tests/batch-invites.test.ts tests/webhooks.test.ts tests/interview-forms.test.ts",
    "test:functional": "node --import tsx --test --test-concurrency=1 tests/functional.test.ts",
    "dev:voice": "npx tsx server/voice-relay.ts",
    "dev:openai-voice": "npx tsx server/openai-voice-relay.ts",
    "dev:voice:gemini": "npx tsx server/gemini-voice-relay.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec db psql -U skillmark -d skillmark",
    "db:dump": "docker compose exec -T db pg_dump -U skillmark -d skillmark --data-only --schema=public --schema=auth > skillmark-data.sql",
    "db:restore": "docker compose exec -T db psql -U skillmark -d skillmark < skillmark-data.sql",
    "mediapipe:assets": "bash scripts/mediapipe-assets.sh"
  },
